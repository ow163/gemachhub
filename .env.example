# העתיקו את הקובץ הזה ל-.env ומלאו את הערכים. הקובץ .env לא עולה ל-Git!

# אפשרות 1 (ברירת המחדל של הצוות): בסיס הנתונים המשותף ב-Supabase
# Supabase > Project Settings > Database > Connection string > Transaction pooler (פורט 6543)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# אפשרות 2: בסיס נתונים מקומי בדוקר (docker compose --profile local-db up --build)
# DATABASE_URL=postgresql://gemach:gemach_local_dev@db:5432/gemachhub

# כתובות שמורשות לפנות ל-API (רק לפיתוח מקומי בלי דוקר)
CORS_ORIGINS=http://localhost:5173
